# Copy to .env and fill values. For Vercel: Project -> Settings -> Environment Variables.

# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Mistral - Matrixbook / vibe coding (HTML generation)
VITE_MISTRAL_API_KEY=
VITE_MISTRAL_MODEL=codestral-2508
# VITE_MISTRAL_API_BASE_URL=https://codestral.mistral.ai/v1

# NVIDIA - legacy direct-provider variables (unused by current Supernova flow)
VITE_NVIDIA_API_KEY=
VITE_NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
# VITE_NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# VITE_NVIDIA_GENAI_BASE_URL=https://ai.api.nvidia.com/v1
# VITE_NVIDIA_IMAGE_GENAI_PATH=qwen/qwen-image
# VITE_NVIDIA_IMAGE_STEPS=25
# VITE_NVIDIA_IMAGE_POLLINATIONS_FALLBACK=true

# OpenRouter - Supernova
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Optional only: used for reference-image editing in Supernova
VITE_OPENROUTER_IMAGE_MODEL=recraft/recraft-v4

# Supernova keyless image generation
VITE_SUPERNOVA_IMAGE_MODEL=flux
