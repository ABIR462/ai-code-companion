# Copy to .env and fill values. For Vercel: Project -> Settings -> Environment Variables.

# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Mistral - Matrixbook / vibe coding (HTML generation)
VITE_MISTRAL_API_KEY=
VITE_MISTRAL_MODEL=codestral-2508
# VITE_MISTRAL_API_BASE_URL=https://codestral.mistral.ai/v1

# Mistral - Supernova image generation
MISTRAL_IMAGE_API_KEY=
MISTRAL_IMAGE_MODEL=mistral-image-latest
MISTRAL_IMAGE_AGENT_MODEL=mistral-medium-latest


# Supernova backend uses MISTRAL_IMAGE_API_KEY, MISTRAL_IMAGE_MODEL, and MISTRAL_IMAGE_AGENT_MODEL.
# If MISTRAL_IMAGE_API_KEY is empty, it falls back to VITE_MISTRAL_API_KEY.
